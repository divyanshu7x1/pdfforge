{
  "name": "pdfforge-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready backend foundation for PDFForge.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "docx": "^9.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.9.0",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.33.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pdf-parse": "^1.1.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  }
}
